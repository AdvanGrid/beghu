##[group]Run (cd served && exec python3 -m http.server 8901 --bind 127.0.0.1) >/dev/null 2>&1 &
(cd served && exec python3 -m http.server 8901 --bind 127.0.0.1) >/dev/null 2>&1 &
for i in $(seq 1 50); do curl -fsS -o /dev/null http://127.0.0.1:8901/version && break; sleep 0.2; done
mkdir -p bin
for p in macos-aarch64 macos-x86_64; do
  curl -fsSL -o "bin/beghu-$p" "http://127.0.0.1:8901/$p/beghu"
  chmod 0755 "bin/beghu-$p"
  if xattr -p com.apple.quarantine "bin/beghu-$p" 2>/dev/null; then
    echo "bin/beghu-$p has a quarantine flag; a curl download shouldn't"; exit 1
  fi
  file "bin/beghu-$p"
  codesign --display --verbose=2 "bin/beghu-$p" 2>&1 | tee "codesign-$p.txt" || true
done
# The arm64 kernel runs only signed code: zig's linker signs it ad hoc. (x86_64 code
# needs no signature, natively or under Rosetta, and zig leaves it unsigned.)
grep -q 'Signature=adhoc' codesign-macos-aarch64.txt || { echo "the arm64 build isn't ad-hoc signed"; exit 1; }
