{
  "url": "https://github.com/AdvanGrid/beghu",
  "public": false,
  "request_oauth_on_install": false,
  "default_permissions": {
    "issues": "write",
    "pull_requests": "read",
    "metadata": "read"
  },
  "default_events": [
    "issues",
    "issue_comment",
    "label",
    "milestone",
    "pull_request",
    "pull_request_review",
    "sub_issues",
    "issue_dependencies",
    "issue_relates_to"
  ]
}
